diff --git a/drivers/tty/Kconfig b/drivers/tty/Kconfig
index 149f3d53b..a530fef97 100644
--- a/drivers/tty/Kconfig
+++ b/drivers/tty/Kconfig
@@ -10,6 +10,13 @@ config TTY
 
 if TTY
 
+config TTY_LOG_FILE
+	bool "RAM-backed tty log file console"
+	default n
+	help
+	  Register ttyLogFile0 as a bounded RAM-backed kernel console and
+	  drain it to /tmp/ttyLog after the root filesystem is available.
+
 config VT
 	bool "Virtual terminal" if EXPERT
 	select INPUT
diff --git a/drivers/tty/Makefile b/drivers/tty/Makefile
index 07aca5184..30bb222dd 100644
--- a/drivers/tty/Makefile
+++ b/drivers/tty/Makefile
@@ -29,3 +29,4 @@ obj-$(CONFIG_VCC)		+= vcc.o
 obj-$(CONFIG_RPMSG_TTY)		+= rpmsg_tty.o
 
 obj-y += ipwireless/
+obj-$(CONFIG_TTY_LOG_FILE)	+= tty_log_file.o
diff --git a/drivers/tty/serial/imx.c b/drivers/tty/serial/imx.c
index 611e338a6..4dbdac23d 100644
--- a/drivers/tty/serial/imx.c
+++ b/drivers/tty/serial/imx.c
@@ -1479,6 +1479,7 @@ static void imx_uart_disable_dma(struct imx_port *sport)
 static int imx_uart_startup(struct uart_port *port)
 {
 	struct imx_port *sport = to_imx_port(port);
+	bool dma_fallback = false;
 	int retval;
 	unsigned long flags;
 	int dma_is_inited = 0;
@@ -1575,11 +1576,17 @@ static int imx_uart_startup(struct uart_port *port)
 	 */
 	imx_uart_enable_ms(&sport->port);
 
-	if (dma_is_inited) {
+	if (dma_is_inited && !imx_uart_start_rx_dma(sport)) {
 		/* Note: enable dma request after transfer start! */
-		imx_uart_start_rx_dma(sport);
 		imx_uart_enable_dma(sport);
 	} else {
+		/*
+		 * A legacy DT can yield channels which allocate successfully but
+		 * cannot prepare their first SDMA descriptor.  Never leave TX DMA
+		 * active in that half-initialised state; use the IRQ/PIO path.
+		 */
+		if (dma_is_inited)
+			dma_fallback = true;
 		ucr1 = imx_uart_readl(sport, UCR1);
 		ucr1 |= UCR1_RRDYEN;
 		imx_uart_writel(sport, ucr1, UCR1);
@@ -1593,6 +1600,12 @@ static int imx_uart_startup(struct uart_port *port)
 
 	uart_port_unlock_irqrestore(&sport->port, flags);
 
+	if (dma_fallback) {
+		dev_warn(sport->port.dev,
+			 "RX DMA is unusable; falling back to interrupt-driven UART\n");
+		imx_uart_dma_exit(sport);
+	}
+
 	return 0;
 }
 

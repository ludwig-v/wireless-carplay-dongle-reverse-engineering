diff --git a/init/initrd_blk.c b/init/initrd_blk.c
new file mode 100644
index 000000000..8d59b8c12
--- /dev/null
+++ b/init/initrd_blk.c
@@ -0,0 +1,129 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Read-only block-device view of the retained boot initrd.
+ *
+ * This allows an EROFS image supplied as an initrd to be mounted directly
+ * with root=/dev/initrd instead of first copying it into /dev/ram0.
+ */
+#include <linux/bio.h>
+#include <linux/blkdev.h>
+#include <linux/init.h>
+#include <linux/initrd.h>
+#include <linux/major.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+
+struct initrd_device {
+	struct gendisk *disk;
+	phys_addr_t size;
+};
+
+static struct initrd_device *initrd_dev;
+
+static void initrd_submit_bio(struct bio *bio)
+{
+	struct initrd_device *dev = bio->bi_bdev->bd_disk->private_data;
+	struct bvec_iter iter;
+	struct bio_vec bvec;
+	sector_t sector = bio->bi_iter.bi_sector;
+
+	if (!initrd_start || op_is_write(bio->bi_opf)) {
+		bio_io_error(bio);
+		return;
+	}
+
+	bio_for_each_segment(bvec, bio, iter) {
+		phys_addr_t offset = sector << SECTOR_SHIFT;
+		void *mem;
+
+		if (offset + bvec.bv_len > dev->size) {
+			bio_io_error(bio);
+			return;
+		}
+
+		mem = kmap_local_page(bvec.bv_page) + bvec.bv_offset;
+		memcpy(mem, (void *)(initrd_start + offset), bvec.bv_len);
+		kunmap_local(mem);
+		flush_dcache_page(bvec.bv_page);
+		sector += bvec.bv_len >> SECTOR_SHIFT;
+	}
+
+	bio_endio(bio);
+}
+
+static const struct block_device_operations initrd_fops = {
+	.owner = THIS_MODULE,
+	.submit_bio = initrd_submit_bio,
+};
+
+static int __init initrd_blk_init(void)
+{
+	struct queue_limits limits = {
+		.logical_block_size = SECTOR_SIZE,
+		.physical_block_size = PAGE_SIZE,
+		.features = BLK_FEAT_SYNCHRONOUS | BLK_FEAT_NOWAIT,
+	};
+	struct gendisk *disk;
+	phys_addr_t size;
+	int error;
+
+	if (!initrd_start || !initrd_end)
+		return -ENODEV;
+
+	size = initrd_end - initrd_start;
+	if (size < SECTOR_SIZE)
+		return -EINVAL;
+
+	initrd_dev = kzalloc(sizeof(*initrd_dev), GFP_KERNEL);
+	if (!initrd_dev)
+		return -ENOMEM;
+
+	disk = blk_alloc_disk(&limits, NUMA_NO_NODE);
+	if (IS_ERR(disk)) {
+		error = PTR_ERR(disk);
+		goto free_device;
+	}
+
+	initrd_dev->disk = disk;
+	initrd_dev->size = size;
+	disk->major = INITRD_MAJOR;
+	disk->first_minor = 0;
+	disk->minors = 1;
+	disk->fops = &initrd_fops;
+	disk->private_data = initrd_dev;
+	strscpy(disk->disk_name, "initrd", DISK_NAME_LEN);
+	set_capacity(disk, size >> SECTOR_SHIFT);
+
+	error = add_disk(disk);
+	if (error)
+		goto put_disk;
+
+	pr_info("initrd_blk: registered read-only /dev/initrd (%llu KiB)\n",
+		(unsigned long long)(size >> 10));
+	return 0;
+
+put_disk:
+	put_disk(disk);
+free_device:
+	kfree(initrd_dev);
+	initrd_dev = NULL;
+	return error;
+}
+
+static void __exit initrd_blk_exit(void)
+{
+	if (!initrd_dev)
+		return;
+
+	del_gendisk(initrd_dev->disk);
+	put_disk(initrd_dev->disk);
+	kfree(initrd_dev);
+	initrd_dev = NULL;
+}
+
+module_init(initrd_blk_init);
+module_exit(initrd_blk_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Retained initrd block device");
+MODULE_ALIAS_BLOCKDEV_MAJOR(INITRD_MAJOR);

diff --git a/net/bluetooth/hci_sysfs.c b/net/bluetooth/hci_sysfs.c
index 041ce9adc..447b8cc35 100644
--- a/net/bluetooth/hci_sysfs.c
+++ b/net/bluetooth/hci_sysfs.c
@@ -102,8 +102,22 @@ static ssize_t reset_store(struct device *dev, struct device_attribute *attr,
 }
 static DEVICE_ATTR_WO(reset);
 
+/*
+ * Legacy Carlinkit userspace polls this attribute before starting hcid.
+ * Keep the old HCI sysfs ABI for the vendor daemon.
+ */
+static ssize_t address_show(struct device *dev,
+			    struct device_attribute *attr, char *buf)
+{
+	struct hci_dev *hdev = to_hci_dev(dev);
+
+	return sysfs_emit(buf, "%pMR\n", &hdev->bdaddr);
+}
+static DEVICE_ATTR_RO(address);
+
 static struct attribute *bt_host_attrs[] = {
 	&dev_attr_reset.attr,
+	&dev_attr_address.attr,
 	NULL,
 };
 ATTRIBUTE_GROUPS(bt_host);

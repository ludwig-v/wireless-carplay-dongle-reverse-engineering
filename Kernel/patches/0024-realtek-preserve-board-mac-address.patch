From: Carlinkit Linux 6.18 port
Subject: [PATCH] wifi: rtl8822bs: preserve the Carlinkit board MAC address

Do not replace the valid address read during probe with the generic Realtek
00:e0:4c:13:36:e4 fallback when vendor userspace cycles wlan0.

--- a/drivers/net/wireless/rtl8822bs/os_dep/linux/os_intfs.c
+++ b/drivers/net/wireless/rtl8822bs/os_dep/linux/os_intfs.c
@@ -1448,6 +1448,9 @@ static int rtw_net_set_mac_address(struct net_device *pnetdev, void *addr)
 	struct mlme_priv *pmlmepriv = &padapter->mlmepriv;
 	struct sockaddr *sa = (struct sockaddr *)addr;
+	u8 *mac = (u8 *)sa->sa_data;
+	static const u8 rtl_fallback_mac[ETH_ALEN] =
+		{ 0x00, 0xe0, 0x4c, 0x13, 0x36, 0xe4 };
 	int ret = -1;
 
 	/* only the net_device is in down state to permit modifying mac addr */
@@ -1470,16 +1473,33 @@ static int rtw_net_set_mac_address(struct net_device *pnetdev, void *addr)
 		return ret;
 	}
 
+	/*
+	 * The vendor userspace briefly cycles wlan0 while starting hostapd.
+	 * Do not let the generic Realtek fallback address replace the valid
+	 * board address already read from EFUSE during that cycle.
+	 */
+	if (_rtw_memcmp(mac, rtl_fallback_mac, ETH_ALEN) == _TRUE
+	    && _rtw_memcmp(adapter_mac_addr(padapter), rtl_fallback_mac,
+			   ETH_ALEN) == _FALSE
+	    && rtw_check_invalid_mac_address(adapter_mac_addr(padapter),
+					     _FALSE) == _FALSE) {
+		RTW_INFO(FUNC_ADPT_FMT": Ignore fallback Mac Addr "MAC_FMT
+			 ", keep "MAC_FMT"\n", FUNC_ADPT_ARG(padapter),
+			 MAC_ARG(mac), MAC_ARG(adapter_mac_addr(padapter)));
+		mac = adapter_mac_addr(padapter);
+	}
+
 	/* check whether the input mac address is valid to permit modifying mac addr */
-	if (rtw_check_invalid_mac_address(sa->sa_data, _FALSE) == _TRUE) {
+	if (rtw_check_invalid_mac_address(mac, _FALSE) == _TRUE) {
 		RTW_INFO(FUNC_ADPT_FMT": Invalid Mac Addr for "MAC_FMT"\n"
-			 , FUNC_ADPT_ARG(padapter), MAC_ARG(sa->sa_data));
+			 , FUNC_ADPT_ARG(padapter), MAC_ARG(mac));
 
 		return ret;
 	}
 
-	_rtw_memcpy(adapter_mac_addr(padapter), sa->sa_data, ETH_ALEN); /* set mac addr to adapter */
+	_rtw_memcpy(adapter_mac_addr(padapter), mac, ETH_ALEN); /* set mac addr to adapter */
 	/*
 	 * Keep the netdev address list synchronized on modern kernels.
 	 * Writing dev_addr directly triggers dev_addr_check() and leaves
@@ -1487,7 +1507,7 @@ static int rtw_net_set_mac_address(struct net_device *pnetdev, void *addr)
 	 * hostapd observing an address different from the adapter hardware.
 	 */
-	eth_hw_addr_set(pnetdev, sa->sa_data);
+	eth_hw_addr_set(pnetdev, mac);
 
 #if 0
 	if (rtw_is_hw_init_completed(padapter)) {
@@ -1512,9 +1532,9 @@ static int rtw_net_set_mac_address(struct net_device *pnetdev, void *addr)
 	LeaveAllPowerSaveModeDirect(padapter); /* leave PS mode for guaranteeing to access hw register successfully */
 #ifdef CONFIG_MI_WITH_MBSSID_CAM
-	rtw_hal_change_macaddr_mbid(padapter, sa->sa_data);
+	rtw_hal_change_macaddr_mbid(padapter, mac);
 #else
-	rtw_hal_set_hwreg(padapter, HW_VAR_MAC_ADDR, sa->sa_data); /* set mac addr to mac register */
+	rtw_hal_set_hwreg(padapter, HW_VAR_MAC_ADDR, mac); /* set mac addr to mac register */
 #endif
 	rtw_ps_deny_cancel(padapter, PS_DENY_IOCTL);
 #endif
 
 	RTW_INFO(FUNC_ADPT_FMT": Set Mac Addr to "MAC_FMT" Successfully\n"
-		 , FUNC_ADPT_ARG(padapter), MAC_ARG(sa->sa_data));
+		 , FUNC_ADPT_ARG(padapter), MAC_ARG(mac));
